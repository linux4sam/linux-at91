/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include "mpfs.dtsi"
#include "mpfs-motor-control-kit-fabric.dtsi"
#include "mpfs095-som.dtsi"

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	model = "Microchip PolarFire-SoC Motor Control Kit";
	compatible = "microchip,mpfs-motor-control-kit-base-rtl-v2601",
		     "microchip,mpfs-motor-control-kit",
		     "microchip,mpfs095-som",
		     "microchip,mpfs";

	aliases {
		serial0 = &mmuart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led-1 {
			gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			label = "led1";
		};

		led-2 {
			gpios = <&gpio2 1 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			linux,default-trigger = "heartbeat";
			label = "heartbeat";
			default-state = "off";
		};
	};
};

&gpio2 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&mac0 {
	dma-noncoherent;
	status = "okay";
	phy-mode = "rgmii-txid";
	phy-handle = <&phy0>;

	phy0: ethernet-phy@1 {
		reg = <0x1>;
	};
};

&mmuart0 {
	status = "okay";
};

&mmuart1 {
	status = "okay";
};

&can1 {
	status = "okay";
};

