config CORE1588_HWTSTAMP
	bool "Generate hardware packet timestamps"
	depends on MICROCHIP_CORETSE
	select PTP_1588_CLOCK
	default n
	help
	  Generate hardware packet timestamps. This is to facilitate IEEE 1588.

config MICROCHIP_CORETSE
	tristate "Microchip 10/100/1000 CoreTSE(Ethernet) support"
	depends on HAS_IOMEM
	select PHYLINK
	help
	  This driver supports the 10/100/1000 Ethernet from Microchip.

	  To compile this driver as a module, choose M here. The module will be
	  called mchp_coretse.
